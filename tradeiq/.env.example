# ============================================================================
# TRADEIQ — Environment Configuration Template (.env.example)
# NEVER commit real secrets or passwords to Git!
# Supports both TRADEIQ canonical names and your existing Render variable names.
# ============================================================================

APP_ENV=development
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Supabase PostgreSQL & Auth (Supports existing SUPABASE_KEY or separate keys) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE

# --- Angel One SmartAPI (Read-Only Market Data; Supports ANGEL_PIN or ANGEL_PASSWORD) ---
ANGEL_API_KEY=YOUR_ANGEL_SMARTAPI_KEY_HERE
ANGEL_CLIENT_CODE=YOUR_ANGEL_CLIENT_CODE_HERE
ANGEL_PIN=YOUR_ANGEL_PIN_HERE
ANGEL_PASSWORD=YOUR_ANGEL_PIN_OR_PASSWORD_HERE
ANGEL_TOTP_SECRET=YOUR_ANGEL_BASE32_TOTP_SECRET_HERE

# --- Single-owner authentication (REQUIRED; without it every private endpoint answers 401) ---
# Option A - built-in owner login (POST /api/v1/auth/login):
#   1) cd backend && python -m app.core.password_hash      -> paste the printed hash below
#   2) python -c "import secrets; print(secrets.token_urlsafe(48))" -> AUTH_JWT_SECRET (>=32 chars,
#      must differ from SUPABASE_JWT_SECRET)
OWNER_PASSWORD_HASH=
AUTH_JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
# Option B - Supabase access tokens: set OWNER_USER_ID to YOUR Supabase user UUID. Tokens for any
# other Supabase user are rejected with 403. (Options can be combined; both map to the same owner.)
OWNER_USER_ID=
# API docs (/docs, /openapi.json) are OFF unless you opt in:
ENABLE_API_DOCS=false

# --- Encryption Key for Broker Credentials at Rest ---
TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_ENCRYPTION_MASTER_KEY_HERE

# --- Gemini AI (Supports single GEMINI_API_KEY or comma-separated GEMINI_API_KEYS) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3
GEMINI_MODEL=gemini-2.5-flash

# --- Optional Telegram Alerts (Closed-Candle & 9:00 AM IST Pre-Market Report) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# --- Optional Extra Stock News APIs (NSE RSS & Google News RSS work without keys) ---
FINNHUB_API_KEY=
MARKETAUX_API_KEY=

# --- Protected Cron Jobs & Error Monitoring ---
INTERNAL_JOB_TOKEN=YOUR_RANDOM_INTERNAL_JOB_SECRET_HERE
SENTRY_DSN=

# Legacy ApexQuant Render variable aliases are accepted directly:
# SUPABASE_KEY, ANGEL_PIN, GEMINI_API_KEYS, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# Keep DEMO_MODE=true until real integrations and security are verified.
